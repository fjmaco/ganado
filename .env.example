# Copia a .env para correr local. En Dokploy, estas van en la pestaña
# Environment de cada servicio — nunca en el repo (es público).

# --- OpenWA (pasarela de WhatsApp) ------------------------------------------
# Dentro de la red de Dokploy los servicios se resuelven por su appName.
OPENWA_URL=http://pericos-openwa-xxxxxx:2785
OPENWA_API_KEY=                      # = API_MASTER_KEY del servicio openwa
# OJO: las rutas de OpenWA usan el UUID de la sesión, no su nombre.
OPENWA_SESSION_ID=
OPENWA_WEBHOOK_SECRET=               # secreto HMAC; el mismo al registrar el webhook

# --- Quién puede hablarle al bot --------------------------------------------
# Números con indicativo, sin '+', separados por coma. Cualquier otro se ignora.
ALLOWED_SENDERS=573001112233
# Tu número, para las alertas técnicas (no las ve tu papá).
ADMIN_WHATSAPP=573009998877

# --- Gateway LiteLLM ---------------------------------------------------------
LITELLM_URL=http://llm.lamhara.co
LITELLM_API_KEY=

# Un tier por tarea. El gateway cae solo hacia abajo (x-high -> ... -> lowest),
# así que esto fija un techo, no una garantía.
TIER_TRIAGE=low
TIER_EXTRAER_TEXTO=low
TIER_EXTRAER_VOZ=medium
TIER_CONSULTA=medium
TIER_NARRAR=high
TIER_INSIGHT=x-high
MODELO_TRANSCRIBIR=transcribe

# --- Google Sheets -----------------------------------------------------------
SHEET_ID=                            # el id que sale en la URL de la hoja
# JSON de la service account en base64:  base64 -w0 credenciales.json
GOOGLE_SA_JSON_B64=
HOJA_REGISTROS=Registros
HOJA_VACAS=Vacas

# --- Límites de cordura de un peso -------------------------------------------
PESO_MIN_KG=50
PESO_MAX_KG=1200
SALTO_SOSPECHOSO_PCT=20              # % de cambio contra el peso anterior que dispara pregunta

# Peso al que vende. 0 lo desactiva por completo. Con esto puesto contesta
# "¿cuáles puedo vender?" y en cada eco le dice cuánto le falta a esa vaca.
PESO_OBJETIVO_KG=0

# --- Comportamiento ----------------------------------------------------------
# Whisper puede oír mal un número deletreado, así que las notas de voz se
# confirman antes de escribirse. Ponlo en false cuando le tengas confianza.
VOZ_REQUIERE_CONFIRMACION=true
VENTANA_CONFIRMACION_MIN=30
VENTANA_CORRECCION_H=24

# --- Resumen mensual sin que lo pida -----------------------------------------
RESUMEN_MENSUAL=true
RESUMEN_DIA=1
RESUMEN_HORA=8

# --- Latido semanal, sólo para mí --------------------------------------------
# Un bot muerto entre pesajes se descubriría semanas después, porque él pesa
# una vez al mes. Esto avisa cada semana, incluso (sobre todo) si nadie lo usó.
LATIDO_SEMANAL=true
LATIDO_DIA=0                         # 0=lunes … 6=domingo
LATIDO_HORA=8

# --- Plumbing ----------------------------------------------------------------
DB_PATH=/data/pericos.db
TZ=America/Bogota
MAX_INTENTOS=5
TIMEOUT_MENSAJE_SEG=150              # techo por mensaje; hay un solo worker
LOG_LEVEL=INFO
